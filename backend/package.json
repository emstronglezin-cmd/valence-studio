{
  "name": "valence-studio-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "postinstall": "node -e \"import('node:fs').then(fs=>{try{if(!fs.existsSync('../node_modules'))fs.symlinkSync('backend/node_modules','../node_modules','dir')}catch{}})\"",
    "build": "node -e \"console.log('Backend subdir build OK')\"",
    "start": "node src/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.47.10",
    "@upstash/qstash": "2.7.17",
    "cors": "2.8.5",
    "csv-parse": "5.6.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "stripe": "17.5.0",
    "zod": "3.24.1"
  }
}
