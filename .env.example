# ==============================================================================
# VALENCE STUDIO — CONFIGURATION BACKEND (.env.example)
# ==============================================================================
# Copiez ce fichier vers `backend/.env` en local, ou configurez ces variables
# dans le dashboard Render (Environment Variables) en production.
# AUCUNE de ces clés ne doit jamais être placée dans le dossier `frontend/`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVEUR & DOMAINE FRONT-END (CORS STRICT)
# ------------------------------------------------------------------------------
# 'production' sur Render, 'development' en local
NODE_ENV=production

# Port d'écoute HTTP (Render injecte automatiquement PORT=10000)
PORT=3000

# URL publique du backend déployé sur Render (sans slash final)
# Utilisée pour construire les liens de téléchargement, webhooks, double opt-in et jobs QStash
BACKEND_PUBLIC_URL=https://valence-studio-api.onrender.com

# URL publique de la boutique GitHub Pages (sans slash final)
# Utilisée pour les redirections après paiement, confirmation d'email et sitemap SEO
FRONTEND_PUBLIC_URL=https://emstronglezin-cmd.github.io/valence-studio

# Liste des origines autorisées par CORS (séparées par des virgules, sans slash final)
# En production, limitez strictement à votre domaine GitHub Pages ou nom de domaine custom
ALLOWED_ORIGINS=https://emstronglezin-cmd.github.io

# Servir le dossier ../frontend depuis Express (false sur Render, true pour démo locale tout-en-un)
SERVE_FRONTEND_STATIC=false

# ------------------------------------------------------------------------------
# 2. SÉCURITÉ, ADMIN & SIGNATURES INTERNES
# ------------------------------------------------------------------------------
# Clé secrète longue (min. 32 caractères aléatoires) pour accéder à /api/admin/*
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=remplacer_par_une_cle_admin_aleatoire_de_64_caracteres_minimum

# Secret HMAC interne (min. 32 caractères) pour signer les URLs de téléchargement (24h/3 max),
# les jetons de double opt-in, les liens de désinscription et l'anonymisation IP des visites
APP_HMAC_SECRET=remplacer_par_un_secret_hmac_aleatoire_de_64_caracteres_minimum

# ------------------------------------------------------------------------------
# 3. SUPABASE (BASE DE DONNÉES POSTGRESQL & STORAGE PRIVÉ)
# ------------------------------------------------------------------------------
# Dashboard Supabase -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# IMPORTANT : utiliser la clé `service_role` (secrète, côté backend uniquement)
# Elle permet au backend d'écrire les commandes et de signer les URLs du bucket privé
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Nom du bucket Supabase Storage PRIVÉ contenant vos fichiers numériques (.zip, .pdf, .csv)
SUPABASE_STORAGE_BUCKET=digital-products

# Chemin du fichier d'extrait gratuit (Lead Magnet) dans le bucket Supabase Storage privé
LEAD_MAGNET_STORAGE_PATH=free/valence-starter-kit.zip

# Contraintes de livraison après paiement
DOWNLOAD_LINK_TTL_HOURS=24
DOWNLOAD_MAX_COUNT=3

# ------------------------------------------------------------------------------
# 4. PAIEMENT — SASPAY (PRINCIPAL) & STRIPE (EN OPTION)
# ------------------------------------------------------------------------------
# Provider actif par défaut si non précisé au checkout : 'saspay' ou 'stripe'
DEFAULT_PAYMENT_PROVIDER=saspay

# Mode bac à sable local (true uniquement pour tester le tunnel sans vraies clés API ;
# mettre impérativement à false en production !)
PAYMENT_SANDBOX_MODE=false

# --- SASPAY ---
# Endpoints et identifiants marchand Saspay à brancher dès réception de vos accès API
SASPAY_API_BASE_URL=https://api.saspay.com
SASPAY_CHECKOUT_PATH=/v1/checkout/sessions
SASPAY_MERCHANT_ID=votre_merchant_id_saspay
SASPAY_API_KEY=votre_cle_api_saspay
# Secret partagé pour vérifier la signature HMAC-SHA256 sur le body brut du webhook
SASPAY_WEBHOOK_SECRET=votre_secret_webhook_saspay
# Nom de l'en-tête HTTP contenant la signature envoyée par Saspay
SASPAY_SIGNATURE_HEADER=x-saspay-signature

# --- STRIPE (OPTIONNEL) ---
# Laissez vide si vous n'activez pas Stripe ; remplissez pour proposer Stripe au checkout
STRIPE_SECRET_KEY=votre_cle_stripe_secrete_optionnelle
STRIPE_WEBHOOK_SECRET=votre_secret_webhook_stripe_optionnel

# ------------------------------------------------------------------------------
# 5. BREVO (EMAILS TRANSACTIONNELS, LIVRAISON, NURTURING & DIGEST MATINAL)
# ------------------------------------------------------------------------------
# Dashboard Brevo -> SMTP & API -> Clés API (v3)
BREVO_API_KEY=votre_cle_api_brevo_v3

# Expéditeur vérifié dans Brevo (Senders & IP)
EMAIL_FROM_ADDRESS=bonjour@votredomaine.com
EMAIL_FROM_NAME=Valence Studio

# Votre adresse email personnelle pour recevoir chaque matin le digest de contenus IA
OWNER_DIGEST_EMAIL=fondateur@votredomaine.com

# ------------------------------------------------------------------------------
# 6. GROQ (AGENT IA : SÉQUENCE NURTURING & GÉNÉRATEUR DE CONTENU QUOTIDIEN)
# ------------------------------------------------------------------------------
# Console Groq (https://console.groq.com/keys)
GROQ_API_KEY=votre_cle_api_groq

# Modèle imposé pour la génération rapide et qualitative
GROQ_MODEL=llama-3.3-70b-versatile

# Thématiques cibles de la boutique pour guider l'agent d'acquisition quotidien
ACQUISITION_NICHE=Produits numériques B2B, templates Notion & Design, systèmes de prompts IA, prospection internationale et automatisation pour freelances, studios et PME

# ------------------------------------------------------------------------------
# 7. UPSTASH QSTASH (PLANIFICATION SANS ÉTAT & KEEPALIVE RENDER */5)
# ------------------------------------------------------------------------------
# Console Upstash -> QStash -> Détails de connexion
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=votre_qstash_token
QSTASH_CURRENT_SIGNING_KEY=votre_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=votre_qstash_next_signing_key

# Expression cron du générateur quotidien de contenu + digest email (UTC, ex: 07:00 UTC)
DAILY_CONTENT_CRON=0 7 * * *

# ------------------------------------------------------------------------------
# 8. ANNUAIRE B2B (CONTRÔLE QUALITÉ AUTOMATIQUE)
# ------------------------------------------------------------------------------
# Activer la vérification DNS/MX réelle des domaines lors de l'import CSV (true recommandé)
B2B_VERIFY_DNS_MX=true
